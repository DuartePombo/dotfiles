# readline (bash and other programs' line editing): the system's settings, plus a few lines
$include /etc/inputrc

# kitty sends Shift+Enter as ESC [13;2u (kitty.conf, so Claude Code gets a new line inside tmux): in bash it's Enter
"\e[13;2u": accept-line

# Esc on its own clears the line (like Windows). Without this, readline treats Esc followed by ANY later key as Alt+key
# and waits for that key forever: Esc, then c, opened fzf's Alt+C folder picker. Now a lone Esc only waits 0.1 s:
# real Alt keys still work (the terminal sends Esc and the key together), and so do arrows and Shift+Enter.
set keyseq-timeout 100
"\e": kill-whole-line
