#!/bin/bash
# Back up the home folder to the USB stick (the "Ventoy" stick) with restic: encrypted, versioned, incremental.
# Starts by itself when the stick is plugged in (udev → backup-usb.service), daily while it stays plugged in
# (backup-usb-check.timer), and reminds you when the last backup is older than 7 days.
#   backup-usb          back up now, if the stick is there
#   backup-usb check    the daily check: back up if the stick is there, otherwise remind if overdue
# Backups: <stick>/helios-backup/restic. Password: ~/.config/restic/password (only on this laptop: keep a copy
# somewhere else, or the backups can't be opened after losing the laptop). Skipped paths: excludes.txt.
# Browse or restore:  restic -r /run/media/$USER/Ventoy/helios-backup/restic -p ~/.config/restic/password snapshots
# Only this one stick is ever written to: it's first mounted read-only, and the backup only runs if the stick holds
# a restic repository whose ID matches ~/.config/restic/repository-id and that opens with the password. Any other
# stick (Ventoy or not) is left untouched. New stick or repository: put its ID there (restic cat config | jq .id).
set -u

label=Ventoy
repo_dir=helios-backup/restic
password_file="$HOME/.config/restic/password"
expected_id=$(cat "$HOME/.config/restic/repository-id" 2>/dev/null || true)
excludes="$HOME/.config/restic/excludes.txt"
state="$HOME/.local/state/backup-usb"
remind_days=7

mkdir -p "$state"
notify() { notify-send --app-name=Backup "$@" 2>/dev/null || true; }

exec 9>"$state/lock"
flock -n 9 || exit 0 # a backup is already running

dev=$(lsblk -nrpo NAME,LABEL | awk -v l="$label" '$2 == l { print $1; exit }')
if [ -z "$dev" ]; then
    if [ "${1:-}" = check ]; then
        last=$(cat "$state/last-success" 2>/dev/null || echo 0)
        age_days=$((($(date +%s) - last) / 86400))
        if [ "$age_days" -ge "$remind_days" ]; then
            if [ "$last" -eq 0 ]; then msg="No backup yet."; else msg="The last backup is $age_days days old."; fi
            notify "Backup reminder" "$msg Plug in the USB stick to back up."
        fi
    fi
    exit 0
fi

mount_stick() { # mount_stick [ro]: mount the stick (read-only with "ro"), set $mp
    local opts=()
    [ "${1:-}" = ro ] && opts=(--options ro)
    udisksctl mount -b "$dev" "${opts[@]}" --no-user-interaction >/dev/null 2>&1 || return 1
    mp=$(lsblk -nro MOUNTPOINTS "$dev" | head -n 1)
    [ -n "$mp" ]
}
unmount_stick() { udisksctl unmount -b "$dev" --no-user-interaction >/dev/null 2>&1; }

# 1. Is this our backup stick? Look read-only, so another stick is never written to.
mounted_here=false
mp=$(lsblk -nro MOUNTPOINTS "$dev" | head -n 1)
if [ -z "$mp" ]; then
    mount_stick ro || exit 0
    mounted_here=true
fi
found_id=""
if [ -f "$mp/$repo_dir/config" ]; then
    found_id=$(restic -r "$mp/$repo_dir" --password-file "$password_file" --no-lock cat config 2>/dev/null |
        jq -r '.id // empty' 2>/dev/null)
fi
if [ -z "$expected_id" ] || [ "$found_id" != "$expected_id" ]; then # another stick, or not our repository
    if $mounted_here; then unmount_stick; fi
    exit 0
fi

# 2. It is: mount it read-write for the backup.
if $mounted_here; then
    unmount_stick
    if ! mount_stick; then
        notify --urgency=critical "Backup failed" "The USB stick couldn't be mounted for writing."
        exit 1
    fi
elif findmnt -no OPTIONS "$mp" | tr ',' '\n' | grep -qx ro; then
    notify --urgency=critical "Backup skipped" "The USB stick is mounted read-only. Eject it and plug it in again."
    exit 1
fi

notify "Backing up…" "Home folder → USB stick. Don't unplug it until the backup says it's done."
export RESTIC_REPOSITORY="$mp/$repo_dir" RESTIC_PASSWORD_FILE="$password_file"
result=failed
if restic backup "$HOME" --exclude-file="$excludes" --exclude-caches --one-file-system --tag auto \
        >"$state/last.log" 2>&1 &&
    restic forget --keep-daily 7 --keep-weekly 4 --keep-monthly 12 --prune >>"$state/last.log" 2>&1; then
    date +%s >"$state/last-success"
    result=ok
fi
sync
if $mounted_here; then
    udisksctl unmount -b "$dev" --no-user-interaction >/dev/null 2>&1 && unplug="You can unplug the stick." ||
        unplug="Eject it in Dolphin before unplugging."
else
    unplug="Eject it in Dolphin before unplugging."
fi
if [ "$result" = ok ]; then
    added=$(grep -m1 "^Added to the repository" "$state/last.log" | sed 's/^Added to the repository: //')
    notify "Backup done" "Added ${added:-nothing new}. $unplug"
else
    notify --urgency=critical "Backup failed" "Details: ~/.local/state/backup-usb/last.log. $unplug"
    exit 1
fi
