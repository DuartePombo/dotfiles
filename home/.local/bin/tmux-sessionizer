#!/usr/bin/env bash
# tmux-sessionizer: pick a project folder with fzf and switch to a tmux session for it, creating it if needed.
# Usage: tmux-sessionizer [folder]   (alias `fz`; inside tmux: prefix + f)
# Folders searched (one level deep): $TMUX_SESSIONIZER_PATHS, space-separated. Default: ~/pombo/projects
# Machine-local extra folders go in ~/.bashrc.local, e.g.
#   export TMUX_SESSIONIZER_PATHS="$HOME/pombo/projects $HOME/some/other/folder"

if [[ $# -eq 1 ]]; then
    selected=$1
else
    read -ra paths <<< "${TMUX_SESSIONIZER_PATHS:-$HOME/pombo/projects}"
    selected=$(find "${paths[@]}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort | fzf)
fi
[[ -z $selected ]] && exit 0

name=$(basename "$selected" | tr . _)

if ! tmux has-session -t "=$name" 2>/dev/null; then
    tmux new-session -ds "$name" -c "$selected"
fi

if [[ -n $TMUX ]]; then
    tmux switch-client -t "=$name"
else
    tmux attach-session -t "=$name"
fi
