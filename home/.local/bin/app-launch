#!/bin/bash
# Starts apps under fixed window names, so Hyprland opens each on its home workspace (hyprland.lua, "Fixed homes
# for apps"). Used by the menu entries in ~/.local/share/applications.
#   app-launch work-projects          kitty + the tmux session "work" (fz / Ctrl+b f switch projects inside)  → 1
#   app-launch chrome-work [url]      work Chrome, its own data folder ~/.config/google-chrome-work            → 2
#   app-launch work-notes             kitty + Neovim in the work notes folder (p pastes a screenshot)            → 4
#                                     (the folder: first line of ~/.work-notes.local, local only; else ~/notes/work)
#   app-launch chrome-personal [url]  personal Chrome (the usual ~/.config/google-chrome)                      → 6
#   app-launch whatsapp               WhatsApp Web in its own app window, data in ~/.config/whatsapp-web        → 7
set -u

case "${1:-}" in
    work-projects)
        exec kitty --class work-projects tmux new-session -A -s work ;;
    chrome-work)
        shift
        exec google-chrome-stable --user-data-dir="$HOME/.config/google-chrome-work" --class=chrome-work "$@" ;;
    work-notes)
        notes="$HOME/notes/work"
        if [[ -f $HOME/.work-notes.local ]]; then
            line=$(grep -v -E '^[[:space:]]*(#|$)' "$HOME/.work-notes.local" | head -n 1)
            [[ -n $line ]] && notes=${line/#\~/$HOME}
        fi
        mkdir -p "$notes"
        cd "$notes" || exit 1
        # opens today's daily note (Neovim's <leader>n keys: lua/custom/notes.lua, same folder rule as above)
        exec kitty --class work-notes nvim "+lua require('custom.notes').daily()" ;;
    chrome-personal)
        shift
        exec google-chrome-stable --class=chrome-personal "$@" ;;
    whatsapp)
        # WhatsApp Web as an app window of the PERSONAL Chrome profile: Chrome opens links clicked in it in the profile
        # the window belongs to, so they land in personal Chrome (with its own profile, ~/.config/whatsapp-web until
        # 2026-11-28, they opened in a bare window of that profile). --class=chrome-personal: if this starts the Chrome
        # process, later personal windows still get their class (Chrome ignores --class for the app window itself: it's
        # "chrome-web.whatsapp.com__-<profile>"). Its home rule is silent (hyprland.lua), so: from the menu this focuses
        # the new window; at login (--login) it waits for personal Chrome to be up first and stays in the background.
        wa_class='^chrome-web\.whatsapp\.com__-'
        wa_windows() { hyprctl -j clients | jq -r --arg c "$wa_class" '.[] | select(.class | test($c)) | .address' | sort; }
        if [[ ${2:-} == --login ]]; then
            for _ in $(seq 60); do
                hyprctl -j clients | jq -e 'any(.[]; .class == "chrome-personal")' >/dev/null && break
                sleep 0.5
            done
            exec google-chrome-stable --class=chrome-personal --app=https://web.whatsapp.com
        fi
        before=$(wa_windows)
        setsid -f google-chrome-stable --class=chrome-personal --app=https://web.whatsapp.com >/dev/null 2>&1
        for _ in $(seq 40); do
            new=$(comm -13 <(echo "$before") <(wa_windows) | head -n 1)
            if [[ -n $new ]]; then
                hyprctl eval "hl.dispatch(hl.dsp.focus({ window = \"address:$new\" }))" >/dev/null
                break
            fi
            sleep 0.25
        done ;;
    *)
        echo "usage: app-launch work-projects|chrome-work|work-notes|chrome-personal|whatsapp" >&2
        exit 2 ;;
esac
