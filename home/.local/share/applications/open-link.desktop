[Desktop Entry]
Type=Application
Name=Open link (work or personal Chrome)
Comment=Default browser: links from Slack open in the work Chrome, everything else in the personal Chrome
Exec=open-link %u
Icon=google-chrome
NoDisplay=true
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/about;x-scheme-handler/unknown;
