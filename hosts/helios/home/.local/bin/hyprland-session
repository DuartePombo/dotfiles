#!/bin/bash
# Start Hyprland on helios, choosing which GPU renders at launch (started from ~/.bash_profile on tty1).
#   mobile (default): Intel renders, only the Intel GPU is given to Hyprland. Apps can still use NVIDIA with
#                     prime-run. (The NVIDIA GPU stays powered on either way: runtime D3 is off.)
#   docked:           an external monitor is connected to an NVIDIA connector: NVIDIA renders, Intel is
#                     second, with the NVIDIA env vars from the old config.
# Force a mode with an argument: hyprland-session mobile, or hyprland-session docked.
# The chosen mode is exported as HELIOS_GPU_MODE for host.lua, and logged: journalctl -t hyprland-session

intel_pci=0000:00:02.0
nvidia_pci=0000:01:00.0

# GPUs are pinned by PCI address (/dev/dri/by-path), never by cardN, which changes between boots.
# The by-path names contain ':', the separator in AQ_DRM_DEVICES, so pass the resolved /dev/dri/cardN instead.
card_of() {
    readlink -f "/dev/dri/by-path/pci-$1-card"
}

# Is an external monitor connected to one of the NVIDIA GPU's connectors?
# Reading a connector's status can wake the NVIDIA GPU; it goes back to sleep on its own afterwards.
external_on_nvidia() {
    local conn card
    for conn in /sys/class/drm/card*-*; do
        card=${conn##*/}
        card=${card%%-*}
        [[ $(basename "$(readlink -f "/sys/class/drm/$card/device")") == "$nvidia_pci" ]] || continue
        [[ $(<"$conn/status") == connected ]] && return 0
    done
    return 1
}

intel_card=$(card_of "$intel_pci")
nvidia_card=$(card_of "$nvidia_pci")

mode=${1:-}
if [[ -z $mode ]]; then
    if [[ -e $nvidia_card ]] && external_on_nvidia; then
        mode=docked
    else
        mode=mobile
    fi
fi

if [[ $mode == docked && -e $nvidia_card ]]; then
    export AQ_DRM_DEVICES="$nvidia_card:$intel_card"
    export GBM_BACKEND=nvidia-drm
    export __GLX_VENDOR_LIBRARY_NAME=nvidia
    export LIBVA_DRIVER_NAME=nvidia
else
    mode=mobile
    export AQ_DRM_DEVICES="$intel_card"
    # Programs draw with Intel too (OpenGL through EGL: Wayland apps, the lock screen). Without this they picked
    # NVIDIA's EGL first, and after a suspend the lock screen froze half faded-in (2026-11-26 and 11-28: NVIDIA
    # logged a power event error at wake-up). prime-run (~/.local/bin/prime-run) puts NVIDIA back for one program,
    # so games still get it; Vulkan (Proton/DXVK games) isn't limited here.
    export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
fi
export HELIOS_GPU_MODE=$mode

logger -t hyprland-session "mode=$mode AQ_DRM_DEVICES=$AQ_DRM_DEVICES"
start-hyprland
