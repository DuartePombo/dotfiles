# This repo is public. Keep secrets and app data out of it.

# Keys and credentials
**/.ssh/
**/.gnupg/
**/.config/gh/
*.pem
*.key
.netrc
.env
.env.*
**/.local/share/keyrings/
# WinApps: the Windows account (only compose.yaml and oem/ belong in the repo)
**/.config/winapps/windows.env
**/.config/winapps/winapps.conf
# Backup password (restic)
**/.config/restic/password
**/.config/freerdp/

# Machine-local files with work or personal paths (they live in ~, never in the repo)
**/.bashrc.local
**/.tmux-sessionizer.local

# App data (logins, caches)
**/.config/google-chrome/
**/.config/google-chrome-work/
**/.config/whatsapp-web/
**/.config/discord/
**/.config/Mullvad VPN/
**/.config/Code/
**/.config/libreoffice/
**/.vscode/
**/.mozilla/
