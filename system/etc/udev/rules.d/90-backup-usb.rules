# Plugging in a USB stick labelled "Ventoy" starts the user's backup (backup-usb.service in the user's systemd).
# backup-usb only backs up if the stick holds helios-backup/restic; any other Ventoy stick is left alone.
ACTION=="add", SUBSYSTEM=="block", ENV{ID_BUS}=="usb", ENV{ID_FS_LABEL}=="Ventoy", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="backup-usb.service"
